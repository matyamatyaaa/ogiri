<h1><%= @topic.body %></h1>
<p>投稿者：<%= @topic.author %></p>

<h2>回答一覧</h2>

<% @topic.answers.each do |answer| %>
  <div>
    <p><%= answer.body %></p>
    <p>回答者：<%= answer.author %></p>
    <p>
     笑い<%= answer.likes.where(level: "warai").count %>
     大笑い<%= answer.likes.where(level: "oowarai").count %>
     爆笑<%= answer.likes.where(level: "bakusho").count %>
    </p>

    <p>
     <%= button_to "笑い", answer_likes_path(answer,"warai") %>
     <%= button_to "大笑い", answer_likes_path(answer,"oowarai") %>
     <%= button_to "爆笑", answer_likes_path(answer,"bakusho") %>
    </p> 
  </div>
<% end %>

<h2>回答する</h2>

<%= form_with model: Answer.new, url: topic_answers_path(@topic) do |form| %>
  <div>
    <%= form.label :body, "回答" %>
    <%= form.text_area :body %>
  </div>

  <div>
    <%= form.label :author, "回答者名" %>
    <%= form.text_field :author %>
  </div>

  <%= form.submit "投稿する" %>
<% end %>

<%= link_to "一覧に戻る", root_path %>